{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "createx-web",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "createx.us/*",
      "zone_name": "createx.us",
    },
    {
      "pattern": "www.createx.us/*",
      "zone_name": "createx.us",
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
